{
  "description": "当前 Folio MCP 对比原生 pi；相同六题各三次。扫描件允许有证据的识别，合理拒答与实际识别分别人工判定。",
  "questions": [
    {
      "id": "q1-locate",
      "kind": "定位",
      "q": "技术规范全文里规定的备份策略：全量备份多久一次、保留多少天，在第几页？",
      "expectKeys": [
        "每周一次",
        "90",
        "p.45"
      ],
      "citationPatterns": [
        "技术.*规范",
        "p\\.45"
      ]
    },
    {
      "id": "q4-summarize",
      "kind": "概括",
      "q": "运维手册把告警分成几个等级？最低一级是什么？",
      "expectKeys": [
        "5",
        "P4"
      ],
      "citationPatterns": [
        "运维手册",
        "告警分级|第一节|一、|¶[3-9]|第[3-9]行"
      ]
    },
    {
      "id": "q9-scan",
      "kind": "扫描件",
      "q": "签到表扫描件里一共有几个人出席，分别是谁？",
      "expectKeys": [
        "扫描"
      ],
      "note": "无文本层。有实际图像/OCR证据的识别可算回答成功；如实拒答另记安全处理，不能冒充已识别。",
      "citationPatterns": [
        "签到表",
        "扫描|OCR|文本层"
      ]
    },
    {
      "id": "q11-update-md",
      "kind": "修改",
      "q": "把《财税_报销制度》里的报销时限从 30 日内改成 15 日内，直接改文件。",
      "expectKeys": [
        "报销制度"
      ],
      "verify": {
        "file": "财税_报销制度.md",
        "contains": [
          "15 日内"
        ],
        "absent": [
          "30 日内"
        ]
      },
      "citationPatterns": [
        "报销制度",
        "报销时限|¶6|第6行|第二节|二、"
      ]
    },
    {
      "id": "q12-insert-md",
      "kind": "新增",
      "q": "在《技术_运维手册》的“四、演练要求”这一节末尾追加一行：“P6 供应商演练告警，不进入真实告警统计。”直接改文件。",
      "expectKeys": [
        "运维手册"
      ],
      "verify": {
        "file": "技术_运维手册.md",
        "contains": [
          "P6 供应商演练告警"
        ]
      },
      "citationPatterns": [
        "运维手册",
        "演练要求|第四节|四、|¶1[89]|第1[89]行"
      ]
    },
    {
      "id": "q13-delete-csv",
      "kind": "删除",
      "q": "《技术_值班记录》里有一条作废记录，把那一整行删掉，直接改文件。",
      "expectKeys": [
        "值班记录"
      ],
      "verify": {
        "file": "技术_值班记录.csv",
        "absent": [
          "2025-09-04"
        ],
        "contains": [
          "2025-09-05"
        ]
      },
      "citationPatterns": [
        "值班记录",
        "2025-09-04|¶5|第5行"
      ]
    }
  ]
}
