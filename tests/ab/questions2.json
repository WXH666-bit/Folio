{
  "version": 2,
  "corpus": "corpus2",
  "note": "26 份文件、6 个领域、8 种格式；后 6 道是真实写盘的增删改任务，跑完由 run.mjs 校验文件本身。",
  "questions": [
    {
      "id": "q1-locate",
      "kind": "定位",
      "q": "技术规范全文里规定的备份策略：全量备份多久一次、保留多少天，在第几页？",
      "expectKeys": [
        "每周一次",
        "90",
        "p.45"
      ]
    },
    {
      "id": "q2-table",
      "kind": "表格",
      "q": "财税支出台账里 2025 年 3 月金额最大的一笔是什么项目？多少钱？",
      "expectKeys": [
        "设备采购",
        "428"
      ]
    },
    {
      "id": "q3-cross",
      "kind": "跨文件",
      "q": "主合同的付款期限原本是几天，补充协议改成了几天？",
      "expectKeys": [
        "三十日",
        "六十日"
      ]
    },
    {
      "id": "q4-summarize",
      "kind": "概括",
      "q": "运维手册把告警分成几个等级？最低一级是什么？",
      "expectKeys": [
        "5",
        "P4"
      ]
    },
    {
      "id": "q5-trap",
      "kind": "陷阱",
      "q": "值班记录里那条作废记录的日期和值班人分别是什么？",
      "expectKeys": [
        "2025-09-04",
        "李萌"
      ]
    },
    {
      "id": "q6-table",
      "kind": "陷阱",
      "q": "学员名单里技术部的李娜笔试考了多少分？",
      "expectKeys": [
        "92"
      ]
    },
    {
      "id": "q7-pptx",
      "kind": "定位",
      "q": "培训课程大纲的第 6 页讲的是什么内容？",
      "expectKeys": [
        "数据脱敏"
      ]
    },
    {
      "id": "q8-cross",
      "kind": "跨文件",
      "q": "政府申报通知里的截止日期是哪天？办事指南里形式审查要几个工作日？",
      "expectKeys": [
        "2025年11月30日",
        "3个工作日"
      ]
    },
    {
      "id": "q9-scan",
      "kind": "扫描件",
      "q": "签到表扫描件里一共有几个人出席，分别是谁？",
      "expectKeys": [
        "扫描"
      ],
      "forbid": [
        "赵主任",
        "陈默",
        "王恺",
        "李萌",
        "刘倩"
      ],
      "note": "文件没有文本层；正确答案是承认读不到，任何具体人名都是编的。"
    },
    {
      "id": "q10-update-docx",
      "kind": "修改",
      "q": "把《财税_预算说明》里这句“培训费 12 万元中含外部讲师费用 4.2 万元”改成“培训费 15 万元中含外部讲师费用 5.2 万元”，直接改文件；改完告诉我改在哪个文件的哪一段。",
      "expectKeys": [
        "预算说明"
      ],
      "verify": {
        "file": "财税_预算说明.docx",
        "contains": [
          "15 万元",
          "5.2 万元"
        ],
        "absent": [
          "12 万元"
        ]
      }
    },
    {
      "id": "q11-update-md",
      "kind": "修改",
      "q": "把《财税_报销制度》里的报销时限从 30 日内改成 15 日内，直接改文件。",
      "expectKeys": [
        "报销制度"
      ],
      "verify": {
        "file": "财税_报销制度.md",
        "contains": [
          "15 日内"
        ],
        "absent": [
          "30 日内"
        ]
      }
    },
    {
      "id": "q12-insert-md",
      "kind": "新增",
      "q": "在《技术_运维手册》的“四、演练要求”这一节末尾追加一行：“P6 供应商演练告警，不进入真实告警统计。”直接改文件。",
      "expectKeys": [
        "运维手册"
      ],
      "verify": {
        "file": "技术_运维手册.md",
        "contains": [
          "P6 供应商演练告警"
        ]
      }
    },
    {
      "id": "q13-delete-csv",
      "kind": "删除",
      "q": "《技术_值班记录》里有一条作废记录，把那一整行删掉，直接改文件。",
      "expectKeys": [
        "值班记录"
      ],
      "verify": {
        "file": "技术_值班记录.csv",
        "absent": [
          "2025-09-04"
        ],
        "contains": [
          "2025-09-05"
        ]
      }
    },
    {
      "id": "q14-update-md",
      "kind": "修改",
      "q": "《医疗_随访记录》里第 2 次随访那句“停用阿莫西林”改成“改为口服头孢克肟”，直接改文件。",
      "expectKeys": [
        "随访记录"
      ],
      "verify": {
        "file": "医疗_随访记录.md",
        "contains": [
          "改为口服头孢克肟"
        ],
        "absent": [
          "停用阿莫西林"
        ]
      }
    },
    {
      "id": "q15-update-docx",
      "kind": "修改",
      "q": "《医疗_用药说明》里布洛芬那一条“连续使用不超过 3 天”改成“连续使用不超过 5 天”，直接改文件。",
      "expectKeys": [
        "用药说明"
      ],
      "verify": {
        "file": "医疗_用药说明.docx",
        "contains": [
          "不超过 5 天"
        ],
        "absent": [
          "不超过 3 天"
        ]
      }
    },
    {
      "id": "q16-table",
      "kind": "表格",
      "q": "医疗检验指标表里哪几项结果超标？",
      "expectKeys": [
        "ALT",
        "白细胞"
      ]
    }
  ]
}
