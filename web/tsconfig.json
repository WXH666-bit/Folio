{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowImportingTsExtensions": false, "noEmit": true, "types": ["node", "vite/client"]
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../src/**/*.ts"]
}
